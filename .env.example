# Environment: dev | prod
ENVIRONMENT=dev

# Postgres credentials. Used both by:
#   - the `db` service in docker-compose.yml (env-file substitution)
#   - the literal DATABASE_URL below for native `uv run uvicorn` dev.
# Keep the two in sync by hand. Values are deliberately trivial in dev.
POSTGRES_USER=wispr
POSTGRES_PASSWORD=wispr
POSTGRES_DB=wispr

# SQLAlchemy 2.0 async (asyncpg) connection URL for native dev. When
# running fully under docker-compose, the api service's environment:
# block overrides this with db:5432.
DATABASE_URL=postgresql+asyncpg://wispr:wispr@localhost:5432/wispr

# Redis URL for native dev. Compose api service overrides with redis:6379.
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of origins permitted to call the api.
# Local dev needs only the Next dev server; production carries the
# canonical custom domain.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional regex matched against the request Origin in addition to the
# exact-match list above. Production uses it to cover platform-provided
# deployment URLs (alias + per-deployment + per-preview-branch variants
# all share a single shape). Leave empty for local dev.
# Example: ^https://wispr-web(?:-[a-z0-9-]+)?\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEX=

# Logging
LOG_LEVEL=info

# Transactional email (Resend). Leave RESEND_API_KEY empty in local dev to use
# the log-only transport — magic links are written to the app log instead of
# sent, so the auth flow works without an email provider. Set it in production.
RESEND_API_KEY=
# Verified sender. The Resend sandbox sender works without a domain; production
# uses a DKIM-verified address on the app's own domain.
EMAIL_FROM=Wispr <onboarding@resend.dev>
# Public base URL of the web app; magic-link URLs are built against it.
APP_BASE_URL=http://localhost:3000
