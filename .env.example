# Environment: dev | prod
ENVIRONMENT=dev

# Postgres credentials. Used both by:
#   - the `db` service in docker-compose.yml (env-file substitution)
#   - the literal DATABASE_URL below for native `uv run uvicorn` dev.
# Keep the two in sync by hand. Values are deliberately trivial in dev.
POSTGRES_USER=wispr
POSTGRES_PASSWORD=wispr
POSTGRES_DB=wispr

# SQLAlchemy 2.0 async (asyncpg) connection URL for native dev. When
# running fully under docker-compose, the api service's environment:
# block overrides this with db:5432.
DATABASE_URL=postgresql+asyncpg://wispr:wispr@localhost:5432/wispr

# Redis URL for native dev. Compose api service overrides with redis:6379.
REDIS_URL=redis://localhost:6379/0

# CORS — comma-separated list of origins permitted to call the api.
# Local dev needs only the Next dev server; production carries the
# canonical custom domain plus any platform-provided aliases.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
